# Release-Archive (git archive, GitHub-Quellcode-ZIP) enthalten nur, was auf
# einem Webspace gebraucht wird. Entwicklungswerkzeuge bleiben im Repository.
/.docker                    export-ignore
/.github                    export-ignore
/.php-cs-fixer.dist.php     export-ignore
/.gitattributes             export-ignore
/.gitignore                 export-ignore
/composer.json              export-ignore
/composer.lock              export-ignore
/docs                       export-ignore
/infection.json5            export-ignore
/phpmd.xml                  export-ignore
/phpstan-bootstrap.php      export-ignore
/phpstan.neon.dist          export-ignore
/phpunit.xml                export-ignore
/psalm-baseline.xml         export-ignore
/psalm.xml                  export-ignore
/rector.php                 export-ignore
/tests                      export-ignore
/todos                      export-ignore
/tools                      export-ignore

# SQL-Dateien immer mit LF: Tests und update.php vergleichen zeilenweise.
*.sql text eol=lf
